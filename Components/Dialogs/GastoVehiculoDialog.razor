@inject ISnackbar Snackbar
@inject RepGeneral dataconex

<MudDialog Style="min-height: 400px;">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">
            @(GastoParam?.Id == 0 ? "Agregar Gasto" : "Editar Gasto")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formIsValid">
            <MudGrid Spacing="2">
                <!-- Tipo (Status en la imagen) -->
                <MudItem xs="12">
                    <MudSelect T="string"
                               Label="Tipo *"
                               @bind-Value="_gasto.Tipo"
                               Required="true"
                               RequiredError="El tipo es requerido"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var tipo in _tiposGasto)
                        {
                            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Descripción -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_gasto.Descripcion"
                                  Label="Descripción *"
                                  Required="true"
                                  RequiredError="La descripción es requerida"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Monto y Fecha (Fila doble) -->
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_gasto.Monto"
                                     Label="Monto *"
                                     Required="true"
                                     Min="0.01m"
                                     Format="C2"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_fechaNullable"
                                   Label="Fecha *"
                                   DateFormat="dd/MM/yyyy"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <!-- Suplidor / Taller -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_gasto.Suplidor"
                                  Label="Suplidor / Taller"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">Cancelar</MudButton>
        <MudButton OnClick="Guardar" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_formIsValid || _cargando)">
            @if (_cargando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Guardando...</MudText>
            }
            else
            {
                <MudText>Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public GastosVehiculo GastoParam { get; set; } = new();
    [Parameter] public int IdVehiculo { get; set; }

    private MudForm _form = default!;
    private bool _formIsValid;
    private bool _cargando;
    private GastosVehiculo _gasto = new();
    private DateTime? _fechaNullable;
    private IEnumerable<string> _tiposGasto = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        // Cargar lista de tipos desde el backend
        _tiposGasto = await dataconex.ObtenerTipoGastos();

        // Mapear o clonar el objeto parametrizado
        if (GastoParam != null && GastoParam.Id > 0)
        {
            _gasto = new GastosVehiculo
            {
                Id = GastoParam.Id,
                IdVehiculo = GastoParam.IdVehiculo,
                Descripcion = GastoParam.Descripcion,
                Tipo = GastoParam.Tipo,
                Monto = GastoParam.Monto,
                Fecha = GastoParam.Fecha,
                Suplidor = GastoParam.Suplidor
            };
            _fechaNullable = _gasto.Fecha;
        }
        else
        {
            _gasto = new GastosVehiculo
            {
                IdVehiculo = IdVehiculo,
                Fecha = DateTime.Today
            };
            _fechaNullable = DateTime.Today;
        }
    }

    private async Task Guardar()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _cargando = true;
        _gasto.Fecha = _fechaNullable ?? DateTime.Today;

        bool exito;
        string mensaje;

        if (_gasto.Id == 0)
        {
            var res = await dataconex.AgregarGastoVehiculo(_gasto);
            exito = res.Exito;
            mensaje = res.Mensaje;
        }
        else
        {
            var res = await dataconex.EditarGastoVehiculo(_gasto);
            exito = res.Exito;
            mensaje = res.Mensaje;
        }

        _cargando = false;

        if (exito)
        {
            Snackbar.Add(mensaje, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(mensaje, Severity.Error);
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}