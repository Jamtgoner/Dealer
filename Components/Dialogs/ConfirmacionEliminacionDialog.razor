@inject ISnackbar Snackbar

<MudDialog TitleClass="px-6 pt-4 pb-2">

    <TitleContent>
        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: var(--mud-palette-error);">
            Confirmar Eliminación
        </MudText>
    </TitleContent>

    <DialogContent>

        <MudText Typo="Typo.body1" Color="Color.Dark">
            @CuerpoMensaje <b>@InformacionResaltada</b>
        </MudText>

    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-center gap-4 w-100 mb-2 pt-2">
            <MudButton Variant="Variant.Filled"
                       OnClick="Cancelar">
                Cancelar
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       OnClick="Confirmar">
                Eliminar
            </MudButton>
        </div>
    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required string CuerpoMensaje { get; set; }
    [Parameter] public required string InformacionResaltada { get; set; }

    [Parameter] public Func<Task<(bool Exito, string Mensaje)>>? OnConfirm { get; set; }

    private async Task Confirmar()
    {
        if (OnConfirm == null) return;

        try
        {
            var resultado = await OnConfirm.Invoke();

            if (resultado.Exito)
            {
                Snackbar.Add(resultado.Mensaje, Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(resultado.Mensaje, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error crítico: {ex.Message}", Severity.Error);
        }
    }

    private void Cancelar()
    {
        MudDialog?.Cancel();
    }
}