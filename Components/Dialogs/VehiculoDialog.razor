@inject RepGeneral dataconex
@inject ISnackbar Snackbar
@inject IWebHostEnvironment WebHostEnvironment

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">
            @(VehiculoParam?.Id == 0 ? "Agregar Vehículo" : "Editar Vehículo")
        </MudText>
    </TitleContent>
<DialogContent>
    <MudForm @ref="_form" @bind-IsValid="_formIsValid">

        <MudGrid Spacing="4">

            <!-- ========================================================= -->
            <!-- Fila 1: Marca, Modelo, Año, Color -->
            <!-- ========================================================= -->

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Marca
                </MudText>

                <MudTextField @bind-Value="_vehiculo.Marca"
                              Required="true"
                              RequiredError="La marca es requerida"
                              Placeholder="Ej: Toyota"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Modelo
                </MudText>

                <MudTextField @bind-Value="_vehiculo.Modelo"
                              Required="true"
                              RequiredError="El modelo es requerido"
                              Placeholder="Ej: Corolla"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Año
                </MudText>

                <MudNumericField @bind-Value="_vehiculo.Anio"
                                 Required="true"
                                 RequiredError="El año es requerido"
                                 Placeholder="Ej: 2024"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Color
                </MudText>

                <MudTextField @bind-Value="_vehiculo.Color"
                              Placeholder="Ej: Blanco"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>


            <!-- ========================================================= -->
            <!-- Fila 2: VIN, Placa, Millaje, Llaves -->
            <!-- ========================================================= -->

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted  mb-1">
                    VIN
                </MudText>

                <MudTextField @bind-Value="_vehiculo.Vin"
                              Placeholder="Número de identificación"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Número de Placa
                </MudText>

                <MudTextField @bind-Value="_vehiculo.Placa"
                              Placeholder="Ej: A123456"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Millaje
                </MudText>

                <MudNumericField @bind-Value="_vehiculo.Millaje"
                                 Placeholder="Ej: 85000"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Cantidad de Llaves
                </MudText>

                <MudNumericField @bind-Value="_vehiculo.Llaves"
                                 Placeholder="Ej: 2"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>


            <!-- ========================================================= -->
            <!-- Fila 3: Combustible, Transmisión, Estado, Ubicación -->
            <!-- ========================================================= -->

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Tipo de Combustible
                </MudText>

                <MudSelect @bind-Value="_vehiculo.Combustible"
                           Placeholder="Seleccione combustible"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">

                    <MudSelectItem Value="@("Gasolina")">
                        Gasolina
                    </MudSelectItem>

                    <MudSelectItem Value="@("Gasoil / Diésel")">
                        Gasoil / Diésel
                    </MudSelectItem>

                    <MudSelectItem Value="@("Híbrido")">
                        Híbrido
                    </MudSelectItem>

                    <MudSelectItem Value="@("Eléctrico")">
                        Eléctrico
                    </MudSelectItem>

                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Transmisión
                </MudText>

                <MudSelect @bind-Value="_vehiculo.Transmision"
                           Placeholder="Seleccione transmisión"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">

                    <MudSelectItem Value="@("Automática")">
                        Automática
                    </MudSelectItem>

                    <MudSelectItem Value="@("Mecánica")">
                        Mecánica
                    </MudSelectItem>

                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Estado
                </MudText>

                <MudSelect @bind-Value="_vehiculo.Estado"
                           Placeholder="Seleccione estado"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">

                    <MudSelectItem Value="@("Disponible")">
                        Disponible
                    </MudSelectItem>

                    <MudSelectItem Value="@("En Reparación")">
                        En Reparación
                    </MudSelectItem>

                    <MudSelectItem Value="@("Vendido")">
                        Vendido
                    </MudSelectItem>

                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Ubicación
                </MudText>

                <MudTextField @bind-Value="_vehiculo.Ubicacion"
                              Placeholder="Ej: Patio principal"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>


            <!-- ========================================================= -->
            <!-- Sección: Precio de Compra -->
            <!-- ========================================================= -->

            <MudItem xs="12">
                <MudText Typo="Typo.caption"
                         Class="font-weight-bold text-muted text-uppercase">
                    Precio de Compra
                </MudText>
            </MudItem>


            <!-- ========================================================= -->
            <!-- Fila 4: Fecha Compra, Precio Compra, Comprado A, Margen -->
            <!-- ========================================================= -->

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Fecha de Compra
                </MudText>

                <MudDatePicker @bind-Date="_fechaCompraNullable"
                               Editable="true"
                               Placeholder="mm/dd/aaaa"
                               DateFormat="MM/dd/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Precio de Compra
                </MudText>

                <MudNumericField @bind-Value="_vehiculo.PrecioCompra"
                                 Culture="@_enUS"
                                 Placeholder="Ej: 25000.00"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Format="N2" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Comprado a
                </MudText>

                <MudTextField @bind-Value="_vehiculo.CompradoA"
                              Placeholder="Persona o empresa"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudText Class="fw-bold text-muted mb-1">
                    Margen de Ganancia (%)
                </MudText>

                <MudNumericField @bind-Value="_vehiculo.MargenGanancia"
                                 Placeholder="Ej: 15"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>


            <!-- ========================================================= -->
            <!-- Descripción -->
            <!-- ========================================================= -->

            <MudItem xs="12">
                <MudText Class="fw-bold text-muted mb-1">
                    Descripción
                </MudText>

                <MudTextField @bind-Value="_vehiculo.Descripcion"
                              Placeholder="Información adicional del vehículo"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>


            <!-- ========================================================= -->
            <!-- Sección: Desperfectos -->
            <!-- ========================================================= -->

            <MudItem xs="12" Class="mt-2">

                <div class="d-flex align-center gap-1 mb-1">

                    <MudIcon Icon="@Icons.Material.Filled.Warning"
                             Color="Color.Warning"
                             Size="Size.Small" />

                    <MudText Typo="Typo.subtitle2"
                             Class="font-weight-bold">
                        Desperfectos
                    </MudText>

                </div>

                <MudText Class="fw-bold text-muted mb-1">
                    Descripción del desperfecto
                </MudText>

                <div class="d-flex gap-2 align-center">

                    <MudTextField @bind-Value="_nuevoDesperfecto"
                                  Placeholder="Ej: Golpe en puerta izquierda..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AgregarListaDesperfecto"
                               Class="text-capitalize py-2">

                        Agregar

                    </MudButton>

                </div>


                <!-- Chips de desperfectos agregados temporalmente -->
                @if (_listaDesperfectos.Any())
                {
                    <div class="d-flex flex-wrap gap-1 mt-2">

                        @foreach (var desp in _listaDesperfectos)
                        {
                            <MudChip T="string"
                                     OnClose="(() => RemoverDesperfecto(desp))"
                                     Color="Color.Warning"
                                     Variant="Variant.Text">

                                @desp

                            </MudChip>
                        }

                    </div>
                }

            </MudItem>


            <!-- ========================================================= -->
            <!-- Fotos -->
            <!-- ========================================================= -->

            <MudItem xs="12" sm="6" Class="mt-2">

                <MudText Typo="Typo.subtitle2"
                         Class="font-weight-bold mb-1">
                    Fotos
                </MudText>

                <div class="d-flex flex-column gap-2">

                    <div class="d-flex align-center gap-3">

                        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                       FilesChanged="SubirFotosTemporales"
                                       Accept=".jpg,.jpeg,.png"
                                       Multiple>

                            <CustomContent>

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           OnClick="@context.OpenFilePickerAsync"
                                           Class="upload-box d-flex flex-column">

                                    <MudIcon Icon="@Icons.Material.Outlined.FileUpload"
                                             Size="Size.Medium"
                                             Class="mb-1" />

                                    <span style="font-size: 0.75rem;">
                                        Subir
                                    </span>

                                </MudButton>

                            </CustomContent>

                            <SelectedTemplate />

                        </MudFileUpload>

                        <MudText Typo="Typo.caption"
                                 Class="text-muted">

                            @_fotosNombres

                        </MudText>

                    </div>


                    @if (_fotosCargadas.Any())
                    {
                        @foreach (var foto in _fotosCargadas)
                        {
                            <MudChip T="string"
                                     OnClose="(() => RemoverFotoTemporal(foto))"
                                     Color="Color.Default"
                                     Variant="Variant.Filled"
                                     Size="Size.Small"
                                     Class="rounded-pill">

                                @RecortarNombreArchivo(foto.Name) (Nuevo)

                            </MudChip>
                        }
                    }


                    @if (_fotosExistentesBD.Any())
                    {
                        @foreach (var fotoUrl in _fotosExistentesBD)
                        {
                            <MudChip T="string"
                                     OnClose="(() => RemoverFotoExistente(fotoUrl))"
                                     Color="Color.Info"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small"
                                     Class="rounded-pill">

                                @RecortarNombreArchivo(Path.GetFileName(fotoUrl))

                            </MudChip>
                        }
                    }

                </div>

            </MudItem>


            <!-- ========================================================= -->
            <!-- Documentos -->
            <!-- ========================================================= -->

            <MudItem xs="12" sm="6" Class="mt-2">

                <MudText Typo="Typo.subtitle2"
                         Class="font-weight-bold mb-1">
                    Documentos
                </MudText>

                <div class="d-flex flex-column gap-2">

                    <div class="d-flex align-center gap-3">

                        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                       FilesChanged="SubirDocumentosTemporales"
                                       Accept=".pdf,.doc,.docx"
                                       Multiple>

                            <CustomContent>

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           OnClick="@context.OpenFilePickerAsync"
                                           Class="upload-box d-flex flex-column">

                                    <MudIcon Icon="@Icons.Material.Outlined.FileUpload"
                                             Size="Size.Medium"
                                             Class="mb-1" />

                                    <span style="font-size: 0.75rem;">
                                        Subir
                                    </span>

                                </MudButton>

                            </CustomContent>

                            <SelectedTemplate />

                        </MudFileUpload>

                        <MudText Typo="Typo.caption"
                                 Class="text-muted">

                            @_documentosNombres

                        </MudText>

                    </div>


                    @if (_documentosCargados.Any())
                    {
                        @foreach (var doc in _documentosCargados)
                        {
                            <MudChip T="string"
                                     OnClose="(() => RemoverDocumentoTemporal(doc))"
                                     Color="Color.Default"
                                     Variant="Variant.Filled"
                                     Size="Size.Small"
                                     Class="rounded-pill">

                                @RecortarNombreArchivo(doc.Name) (Nuevo)

                            </MudChip>
                        }
                    }


                    @if (_documentosExistentesBD.Any())
                    {
                        @foreach (var docUrl in _documentosExistentesBD)
                        {
                            <MudChip T="string"
                                     OnClose="(() => RemoverDocumentoExistente(docUrl))"
                                     Color="Color.Info"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small"
                                     Class="rounded-pill">

                                @RecortarNombreArchivo(Path.GetFileName(docUrl))

                            </MudChip>
                        }
                    }

                </div>

            </MudItem>

        </MudGrid>

    </MudForm>
</DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Class="px-5 rounded-lg" Variant="Variant.Outlined">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar" Class="px-5 rounded-lg btn-guardar-custom" Disabled="@(!_formIsValid)">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public Vehiculos? VehiculoParam { get; set; }

    private MudForm _form;
    private Vehiculos _vehiculo = new();
    private bool _formIsValid;

    private DateTime? _fechaCompraNullable;

    private string _nuevoDesperfecto = string.Empty;
    private List<string> _listaDesperfectos = new();

    // Variables de control de archivos adjuntos (memorizados temporalmente)
    private List<IBrowserFile> _fotosCargadas = new();
    private List<IBrowserFile> _documentosCargados = new();
    private List<string> _fotosExistentesBD = new();
    private List<string> _documentosExistentesBD = new();
    private string _fotosNombres = "Ningún archivo seleccionado";
    private string _documentosNombres = "Ningún archivo seleccionado";

    // Estructura temporal para recordar qué ruta física y qué tabla limpiar al guardar
    private List<(string Url, string Tabla)> _archivosEliminados = new();

    private System.Globalization.CultureInfo _enUS = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    protected override async Task OnInitializedAsync()
    {
        if (VehiculoParam != null)
        {
            // 1. Clonamos las propiedades del vehículo (Código que ya tienes)
            _vehiculo = new Vehiculos
            {
                Id = VehiculoParam.Id,
                Marca = VehiculoParam.Marca,
                Modelo = VehiculoParam.Modelo,
                Anio = VehiculoParam.Anio == 0 ? 2026 : VehiculoParam.Anio,
                Color = VehiculoParam.Color,
                Vin = VehiculoParam.Vin,
                Placa = VehiculoParam.Placa,
                Millaje = VehiculoParam.Millaje,
                Llaves = VehiculoParam.Llaves == 0 ? 1 : VehiculoParam.Llaves,
                Combustible = string.IsNullOrEmpty(VehiculoParam.Combustible) ? "Gasolina" : VehiculoParam.Combustible,
                Transmision = string.IsNullOrEmpty(VehiculoParam.Transmision) ? "Automática" : VehiculoParam.Transmision,
                Estado = string.IsNullOrEmpty(VehiculoParam.Estado) ? "Disponible" : VehiculoParam.Estado,
                Ubicacion = VehiculoParam.Ubicacion,
                PrecioCompra = VehiculoParam.PrecioCompra,
                CompradoA = VehiculoParam.CompradoA,
                MargenGanancia = VehiculoParam.MargenGanancia == 0 ? 15 : VehiculoParam.MargenGanancia,
                Descripcion = VehiculoParam.Descripcion,
                FechaCompra = VehiculoParam.FechaCompra
            };

            if (_vehiculo.FechaCompra != DateTime.MinValue)
            {
                _fechaCompraNullable = _vehiculo.FechaCompra;
            }

            // 🚀 2. CARGAR DESPERFECTOS EXISTENTES DESDE BASE DE DATOS
            var desperfectosBD = await dataconex.ObtenerDesperfectosVehiculo(_vehiculo.Id);
            if (desperfectosBD != null)
            {
                _listaDesperfectos = desperfectosBD.ToList();
            }

            // 🚀 3. MOSTRAR CONTADORES DE ARCHIVOS EXISTENTES
            var fotos = await dataconex.ObtenerFotosVehiculo(_vehiculo.Id);
            _fotosExistentesBD = fotos.ToList();
            var docs = await dataconex.ObtenerDocumentosVehiculo(_vehiculo.Id);
            _documentosExistentesBD = docs.ToList();

            ActualizarContadoresTexto();
        }
    }

    private void AgregarListaDesperfecto()
    {
        if (!string.IsNullOrWhiteSpace(_nuevoDesperfecto))
        {
            _listaDesperfectos.Add(_nuevoDesperfecto.Trim());
            _nuevoDesperfecto = string.Empty;
        }
    }

    private void RemoverDesperfecto(string desp) => _listaDesperfectos.Remove(desp);

    private void SubirFotoTemporal(IBrowserFile file)
    {
        if (file != null)
        {
            _fotosCargadas.Add(file);
            _fotosNombres = $"{_fotosCargadas.Count} foto(s) seleccionada(s)";
        }
    }

    private void SubirDocumentoTemporal(IBrowserFile file)
    {
        if (file != null)
        {
            _documentosCargados.Add(file);
            _documentosNombres = $"{_documentosCargados.Count} documento(s) seleccionado(s)";
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private void SubirFotosTemporales(IReadOnlyList<IBrowserFile> files)
    {
        if (files != null)
        {
            foreach (var file in files)
            {
                // Evitamos duplicados visuales si eligen el mismo archivo dos veces
                if (!_fotosCargadas.Any(f => f.Name == file.Name && f.Size == file.Size))
                {
                    _fotosCargadas.Add(file);
                }
            }
            ActualizarContadoresTexto();
        }
    }

    private void SubirDocumentosTemporales(IReadOnlyList<IBrowserFile> files)
    {
        if (files != null)
        {
            foreach (var file in files)
            {
                if (!_documentosCargados.Any(d => d.Name == file.Name && d.Size == file.Size))
                {
                    _documentosCargados.Add(file);
                }
            }
            ActualizarContadoresTexto();
        }
    }

    // 🚀 NUEVOS MÉTODOS: Para eliminar archivos de la lista antes de guardar
    private void RemoverFotoTemporal(IBrowserFile file)
    {
        _fotosCargadas.Remove(file);
        ActualizarContadoresTexto();
    }

    private void RemoverDocumentoTemporal(IBrowserFile file)
    {
        _documentosCargados.Remove(file);
        ActualizarContadoresTexto();
    }

    // Helper para mantener los textos limpios y dinámicos
    private void ActualizarContadoresTexto()
    {
        int totalFotos = _fotosCargadas.Count + _fotosExistentesBD.Count;
        _fotosNombres = totalFotos > 0
            ? $"{totalFotos} foto(s) en total"
            : "Ningún archivo seleccionado";

        int totalDocs = _documentosCargados.Count + _documentosExistentesBD.Count;
        _documentosNombres = totalDocs > 0
            ? $"{totalDocs} documento(s) en total"
            : "Ningún archivo seleccionado";
    }

    private void RemoverFotoExistente(string urlArchivo)
    {
        if (string.IsNullOrEmpty(urlArchivo)) return;

        // 1. Lo guardamos en la lista de espera para borrar al Guardar
        _archivosEliminados.Add((urlArchivo, "Fotos"));

        // 2. Lo quitamos de la vista
        _fotosExistentesBD.Remove(urlArchivo);
        ActualizarContadoresTexto();
    }

    private void RemoverDocumentoExistente(string urlArchivo)
    {
        if (string.IsNullOrEmpty(urlArchivo)) return;

        // 1. Lo guardamos en la lista de espera para borrar al Guardar
        _archivosEliminados.Add((urlArchivo, "Documentos"));

        // 2. Lo quitamos de la vista
        _documentosExistentesBD.Remove(urlArchivo);
        ActualizarContadoresTexto();
    }

    // Helper opcional para que los nombres largos de los archivos no desbaraten el diseño de los Chips
    private string RecortarNombreArchivo(string nombre)
    {
        if (nombre.Length > 20)
        {
            return nombre.Substring(0, 12) + "..." + nombre.Substring(nombre.Length - 5);
        }
        return nombre;
    }

    private async Task Guardar()
    {
        await _form.ValidateAsync();
        if (!_formIsValid) return;

        _vehiculo.FechaCompra = _fechaCompraNullable ?? DateTime.Now;

        if (_vehiculo.Id == 0)
        {
            // --- MODO: AGREGAR (NUEVO VEHÍCULO) ---
            var (exito, mensaje, idGenerado) = await dataconex.AgregarVehiculo(_vehiculo);

            if (exito)
            {
                // 1. Guardar Desperfectos
                foreach (var desp in _listaDesperfectos)
                {
                    await dataconex.AgregarDesperfecto(idGenerado, desp);
                }

                // 2. Procesar Fotos Nuevas
                if (_fotosCargadas.Any())
                {
                    string carpetaFotos = Path.Combine(WebHostEnvironment.WebRootPath, "vehiculos");
                    if (!Directory.Exists(carpetaFotos)) Directory.CreateDirectory(carpetaFotos);

                    foreach (var foto in _fotosCargadas)
                    {
                        string nombreUnico = $"{idGenerado}_{Guid.NewGuid()}_{foto.Name}";
                        string rutaFisicaCompleta = Path.Combine(carpetaFotos, nombreUnico);

                        using var stream = foto.OpenReadStream(maxAllowedSize: 1024 * 1024 * 15);
                        using var fileStream = new FileStream(rutaFisicaCompleta, FileMode.Create);
                        await stream.CopyToAsync(fileStream);

                        string urlRelativa = $"/vehiculos/{nombreUnico}";
                        await dataconex.GuardarRutaArchivo(idGenerado, urlRelativa, "Fotos");
                    }
                }

                // 3. Procesar Documentos Nuevos
                if (_documentosCargados.Any())
                {
                    string carpetaDocs = Path.Combine(WebHostEnvironment.WebRootPath, "documentosVehiculos");
                    if (!Directory.Exists(carpetaDocs)) Directory.CreateDirectory(carpetaDocs);

                    foreach (var doc in _documentosCargados)
                    {
                        string nombreUnico = $"{idGenerado}_{Guid.NewGuid()}_{doc.Name}";
                        string rutaFisicaCompleta = Path.Combine(carpetaDocs, nombreUnico);

                        using var stream = doc.OpenReadStream(maxAllowedSize: 1024 * 1024 * 20);
                        using var fileStream = new FileStream(rutaFisicaCompleta, FileMode.Create);
                        await stream.CopyToAsync(fileStream);

                        string urlRelativa = $"/documentosVehiculos/{nombreUnico}";
                        await dataconex.GuardarRutaArchivo(idGenerado, urlRelativa, "Documentos");
                    }
                }
                Snackbar.Add("Vehículo registrado con éxito", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(mensaje, Severity.Error);
            }
        }
        else
        {
            // --- MODO: EDITAR (VEHÍCULO EXISTENTE) ---
            var (exito, mensaje) = await dataconex.EditarVehiculo(_vehiculo);
            if (exito)
            {
                // 1. Guardar Desperfectos
                int index = 0;
                foreach (var desp in _listaDesperfectos)
                {
                    bool limpiar = (index == 0);
                    await dataconex.AgregarDesperfecto(_vehiculo.Id, desp, limpiar);
                    index++;
                }

                // 2. PURGAR ARCHIVOS ELIMINADOS EN LA VISTA (Base de Datos y wwwroot)
                if (_archivosEliminados.Any())
                {
                    foreach (var archivo in _archivosEliminados)
                    {
                        // Borrado lógico de la Base de Datos
                        await dataconex.EliminarArchivoVehiculo(_vehiculo.Id, archivo.Url, archivo.Tabla);

                        // Borrado físico del disco del servidor
                        try
                        {
                            string rutaFisica = Path.Combine(WebHostEnvironment.WebRootPath, archivo.Url.TrimStart('/'));
                            if (File.Exists(rutaFisica))
                            {
                                File.Delete(rutaFisica);
                            }
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"Error eliminando archivo físico en diferido: {ex.Message}");
                        }
                    }

                    _archivosEliminados.Clear(); // Limpiamos la lista de pendientes
                }

                // 3. PROCESAR FOTOS NUEVAS EN LA EDICIÓN
                if (_fotosCargadas != null && _fotosCargadas.Any())
                {
                    string carpetaFotos = Path.Combine(WebHostEnvironment.WebRootPath, "vehiculos");
                    if (!Directory.Exists(carpetaFotos)) Directory.CreateDirectory(carpetaFotos);

                    var fotosAProcesar = _fotosCargadas.ToList();

                    foreach (var foto in fotosAProcesar)
                    {
                        try
                        {
                            string nombreUnico = $"{_vehiculo.Id}_{Guid.NewGuid()}_{foto.Name}";
                            string rutaFisicaCompleta = Path.Combine(carpetaFotos, nombreUnico);

                            // Aumentado preventivamente a 15MB por si las fotos son muy pesadas
                            using var stream = foto.OpenReadStream(maxAllowedSize: 1024 * 1024 * 15);
                            using var fileStream = new FileStream(rutaFisicaCompleta, FileMode.Create);
                            await stream.CopyToAsync(fileStream);

                            string urlRelativa = $"/vehiculos/{nombreUnico}";
                            await dataconex.GuardarRutaArchivo(_vehiculo.Id, urlRelativa, "Fotos");
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"🔴 Error crítico procesando la foto {foto.Name}: {ex.Message}");
                            Snackbar.Add($"No se pudo cargar la foto {foto.Name}.", Severity.Warning);
                        }
                    }

                    _fotosCargadas.Clear(); // Limpiamos la lista temporal de subidas
                }

                // 4. PROCESAR DOCUMENTOS NUEVOS EN LA EDICIÓN
                if (_documentosCargados != null && _documentosCargados.Any())
                {
                    string carpetaDocs = Path.Combine(WebHostEnvironment.WebRootPath, "documentosVehiculos");
                    if (!Directory.Exists(carpetaDocs)) Directory.CreateDirectory(carpetaDocs);

                    var docsAProcesar = _documentosCargados.ToList();

                    foreach (var doc in docsAProcesar)
                    {
                        try
                        {
                            string nombreUnico = $"{_vehiculo.Id}_{Guid.NewGuid()}_{doc.Name}";
                            string rutaFisicaCompleta = Path.Combine(carpetaDocs, nombreUnico);

                            using var stream = doc.OpenReadStream(maxAllowedSize: 1024 * 1024 * 20);
                            using var fileStream = new FileStream(rutaFisicaCompleta, FileMode.Create);
                            await stream.CopyToAsync(fileStream);

                            string urlRelativa = $"/documentosVehiculos/{nombreUnico}";
                            await dataconex.GuardarRutaArchivo(_vehiculo.Id, urlRelativa, "Documentos");
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"🔴 Error crítico procesando el documento {doc.Name}: {ex.Message}");
                            Snackbar.Add($"No se pudo cargar el documento {doc.Name}.", Severity.Warning);
                        }
                    }

                    _documentosCargados.Clear(); // Limpiamos la lista temporal de subidas
                }

                Snackbar.Add("Cambios guardados con éxito", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(mensaje, Severity.Error);
            }
        }
    }
}
