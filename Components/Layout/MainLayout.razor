@inherits LayoutComponentBase

<div id="blazor-error-ui">
    <span class="bi bi-exclamatriangle-fill"></span>
    <strong>¡Ups! Algo salió mal en el servidor.</strong>
    La aplicación no puede continuar hasta que recargues.
    <a href="." class="reload">🔄 Reintentar ahora</a>
    <span class="dismiss">🗙</span>
</div>

@* Required for MudBlazor *@
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

            <MudAppBar Elevation="1" Dense="true" Class="bg-topbar" Gutters="false">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@ToggleDrawer" />
                <MudSpacer />
                <form method="post" action="/api/logout">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Inherit"
                                   ButtonType="ButtonType.Submit" />
                </form>
            </MudAppBar>
            
            <MudDrawer @bind-Open="@_open" Class="bg-sidebar" ClipMode="DrawerClipMode.Always" Elevation="3" Variant="@DrawerVariant.Mini">
                <MudNavMenu Class="nav-custom-white">
                    <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                    <MudNavLink Href="/vehiculos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DirectionsCar">Vehiculos</MudNavLink>
                    <MudNavLink Href="/ventas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.BarChart">Ventas</MudNavLink>
                    <MudNavLink Href="/clientes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
                    <MudNavLink Href="/vendedores" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CoPresent">Vendedores</MudNavLink>
                    <MudNavLink Href="/configuracion" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Configuracion</MudNavLink>
                </MudNavMenu>
            </MudDrawer>

            <MudMainContent Class="mud-height-full">
                <div class="d-flex flex-column mud-height-full">
                @Body
                </div>
            </MudMainContent>
</MudLayout>

@code {
    bool _open = true;
    void ToggleDrawer() => _open = !_open;
}

