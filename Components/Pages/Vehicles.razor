@page "/"
@page "/vehiculos"
@inject RepGeneral dataconex
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Vehiculos</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="flex-none bg-suave">
    <MudPaper Elevation="3" Class="px-6 py-4 my-3">

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" Class="fw-bold">Vehiculos</MudText>
                <MudText Typo="Typo.body2" Color="Color.Primary">Cantidad de vehiculos: @totalVehiculos </MudText>
            </MudStack>
        </MudStack>

        <MudDivider Class="my-3" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <!-- Búsqueda por Texto -->
                <MudTextField @bind-Value="busqueda"
                              Placeholder="Buscar por marca y modelo"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="width:280px; background: white;" />

                <!-- Filtro: Combustible -->
                <MudSelect T="string"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Seleccionar todos"
                           Placeholder="Seleccionar combustible"
                           @bind-SelectedValues="_combustiblesSeleccionados"
                           MultiSelectionTextFunc="MensajeCombustibles"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Style="width:250px; background: white;">
                    @foreach (var c in _listaCombustibles)
                    {
                        <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                    }
                </MudSelect>

                <!-- Filtro: Transmisión -->
                <MudSelect T="string"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Seleccionar todos"
                           Placeholder="Seleccionar transmisión"
                           @bind-SelectedValues="_transmisionesSeleccionadas"
                           MultiSelectionTextFunc="MensajeTransmisiones"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Style="width:250px; background: white;">
                    @foreach (var t in _listaTransmisiones)
                    {
                        <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            <!-- Botón Nuevo Vehículo -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Dark"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NuevoVehiculo"
                       Size="Size.Medium"
                       Style="text-transform: uppercase; font-weight: bold;">
                Nuevo Vehiculo
            </MudButton>

        </MudStack>
    </MudPaper>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 bg-suave flex-grow-1 overflow-auto">

    @if (VehiculosFiltrados == null)
    {
        <MudGrid Justify="Justify.Center" Class="align-center" Style="height: 200px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </MudGrid>
    }
    else if (!VehiculosFiltrados.Any())
    {
        <MudText Typo="Typo.h6" Align="Align.Center" Class="text-muted pa-4">
            No se encontraron vehículos registrados.
        </MudText>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var vehiculo in VehiculosFiltrados)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="1" Class="rounded-lg h-100 d-flex flex-column style-card" @onclick="() => IrAlPerfil(vehiculo.Id)">

                        <!-- Contenedor de la Imagen / Placeholder -->
                        <div class="image-container d-flex align-center justify-center text-muted">
                            @if (_fotosVehiculos.TryGetValue(vehiculo.Id, out var fotoUrl) && !string.IsNullOrEmpty(fotoUrl))
                            {
                                <img src="@fotoUrl" alt="@vehiculo.Marca @vehiculo.Modelo" class="vehicle-img" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.DirectionsCar" Size="Size.Large" Style="font-size: 4rem; opacity: 0.3;" />
                            }
                        </div>

                        <MudCardContent Class="pa-4 flex-grow-1 d-flex flex-column justify-space-between">

                            <div class="d-flex justify-space-between align-start">
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="fw-bold text-uppercase" Color="Color.Default">
                                        @vehiculo.Marca @vehiculo.Modelo
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted text-uppercase">
                                        @vehiculo.Anio • @vehiculo.Color
                                    </MudText>
                                </div>
                                <MudChip T="string" Variant="Variant.Filled" Color="GetEstadoColor(vehiculo.Estado)" Size="Size.Small" Class="rounded-pill px-3 py-1 font-weight-bold">
                                    @vehiculo.Estado
                                </MudChip>
                            </div>

                            <div class="d-flex justify-space-between align-end mt-4">
                                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.25rem;">
                                    @vehiculo.PrecioCompra.ToString("C0")
                                </MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">
                                    @vehiculo.Millaje.ToString("N0") mi
                                </MudText>
                            </div>

                            <div class="mt-2 pt-2 border-top-dash">
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.caption" Class="text-muted">Gastos:</MudText>
                                    <MudText Typo="Typo.caption" Class="fw-bold" Style="color: #D9772E;">@vehiculo.Gastos.ToString("C0")</MudText>
                                </div>

                                <div class="d-flex justify-space-between align-center mt-1">
                                    <div class="d-flex align-center gap-1 text-success">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Style="font-size: 1rem;" />
                                        <MudText Typo="Typo.caption" Class="font-weight-bold">
                                            @((vehiculo.PrecioCompra + vehiculo.MargenGanancia).ToString("C0"))
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted text-lowercase">sugerido</MudText>
                                    </div>

                                    <MudText Typo="Typo.caption" Class="text-muted font-size-xs">
                                        @vehiculo.FechaCompra.ToString("MM/dd/yyyy")
                                    </MudText>
                                </div>
                            </div>

                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>


@code {
    private List<Vehiculos> _fullVehiculos = new();
    private Dictionary<int, string> _fotosVehiculos = new();
    private string busqueda = string.Empty;

    // Listas para poblar los select
    private IEnumerable<string> _listaCombustibles = [];
    private IEnumerable<string> _listaTransmisiones = [];

    // Filtros seleccionados
    private IReadOnlyCollection<string> _combustiblesSeleccionados = Array.Empty<string>();
    private IReadOnlyCollection<string> _transmisionesSeleccionadas = Array.Empty<string>();

    private int totalVehiculos => _fullVehiculos.Count();

    protected override async Task OnInitializedAsync()
    {
        await CargarFiltros();
        await CargarDatos();
    }

    private async Task CargarFiltros()
    {
        _listaCombustibles = await dataconex.ObtenerCombustibles();
        _listaTransmisiones = await dataconex.ObtenerTransmisiones();
    }

    // Cambiar List<string> por IReadOnlyList<string>
    private string MensajeCombustibles(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || selectedValues.Count == 0) return null;
        return $"{selectedValues.Count} combustible{(selectedValues.Count > 1 ? "s" : "")}";
    }

    private string MensajeTransmisiones(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || selectedValues.Count == 0) return null;
        return $"{selectedValues.Count} transmisión{(selectedValues.Count > 1 ? "es" : "")}";
    }

    // Lógica de filtrado dinámico
    private IEnumerable<Vehiculos> VehiculosFiltrados => _fullVehiculos
        .Where(v =>
            (string.IsNullOrWhiteSpace(busqueda) ||
             (v.Marca?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (v.Modelo?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (v.Anio.ToString().Contains(busqueda)) ||
             (v.Color?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (v.Vin?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (v.Placa?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (!_combustiblesSeleccionados.Any() ||
             _combustiblesSeleccionados.Contains(v.Combustible, StringComparer.OrdinalIgnoreCase)) &&
            (!_transmisionesSeleccionadas.Any() ||
             _transmisionesSeleccionadas.Contains(v.Transmision, StringComparer.OrdinalIgnoreCase))
        );

    private async Task CargarDatos()
    {
        var data = await dataconex.ObtenerVehiculos();
        _fullVehiculos = data.ToList();

        var tareasFotos = _fullVehiculos.Select(async v =>
        {
            try
            {
                var fotos = await dataconex.ObtenerFotosVehiculo(v.Id);
                string fotoPrincipal = fotos?.FirstOrDefault() ?? string.Empty;

                lock (_fotosVehiculos)
                {
                    _fotosVehiculos[v.Id] = fotoPrincipal;
                }
            }
            catch
            {
                lock (_fotosVehiculos)
                {
                    _fotosVehiculos[v.Id] = string.Empty;
                }
            }
        });

        await Task.WhenAll(tareasFotos);
    }

    private Color GetEstadoColor(string estado)
    {
        return estado?.ToLower() switch
        {
            "en reparación" => Color.Warning,
            "disponible" => Color.Success,
            "vendido" => Color.Info,
            _ => Color.Default
        };
    }

    private async Task NuevoVehiculo()
    {
        var parametros = new DialogParameters<VehiculoDialog> { { x => x.VehiculoParam, new Vehiculos() } };
        var opciones = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            BackdropClick = false,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<VehiculoDialog>("Agregar Vehículo", parametros, opciones);
        var resultado = await dialog.Result;

        if (!resultado.Canceled)
        {
            await CargarDatos();
        }
    }

    private void IrAlPerfil(int idVehiculo)
    {
        NavigationManager.NavigateTo($"/vehiculo/{idVehiculo}");
    }
}