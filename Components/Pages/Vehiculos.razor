@page "/vehiculos"

<PageTitle>Vehiculos</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="flex-none bg-suave">
    <MudPaper Elevation="3" Class="px-6 py-4 my-3">

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-5">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" Class="fw-bold">Vehiculos</MudText>
                <MudText Typo="Typo.body2" Color="Color.Primary">Gestiona el inventario de tus productos</MudText>
            </MudStack>

            <MudStack Row="true" Spacing="3">
                @* Total *@
                <MudPaper Elevation="0" Class="pa-2 rounded-lg d-flex align-center" Style="background-color: #f0f7ff; border: 1px solid #e0eaff;">
                    <MudIcon Icon="@Icons.Material.Filled.Warehouse" Color="Color.Info" Size="Size.Small" Class="mx-2" />
                    <div class="mr-3">
                        <MudText Style="font-size: 0.7rem; color: #5c708a; line-height: 1;">Total Productos</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">PV55</MudText>
                    </div>
                </MudPaper>

                @* Inventariados *@
                <MudPaper Elevation="0" Class="pa-2 rounded-lg d-flex align-center" Style="background-color: #f0fbf2; border: 1px solid #e0f5e5;">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" Class="mx-2" />
                    <div class="mr-3">
                        <MudText Style="font-size: 0.7rem; color: #437a50; line-height: 1;">Inventariados</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">PV55</MudText>
                    </div>
                </MudPaper>

                @* Stock Bajo *@
                <MudPaper Elevation="0" Class="pa-2 rounded-lg d-flex align-center" Style="background-color: #fff5f5; border: 1px solid #ffe0e0;">
                    <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" Size="Size.Small" Class="mx-2" />
                    <div class="mr-3">
                        <MudText Style="font-size: 0.7rem; color: #a34a4a; line-height: 1;">Stock Bajo</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">PV55</MudText>
                    </div>
                </MudPaper>
            </MudStack>
        </MudStack>

        <MudDivider Class="my-3" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudTextField @bind-Value="busqueda"
                              Placeholder="Buscar por marca, modelo..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="width:300px; background: white;" />
            </MudStack>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NuevoVehiculo"
                       Size="Size.Medium"
                       Style="text-transform: uppercase; font-weight: bold;">
                Nuevo Vehiculo
            </MudButton>

        </MudStack>
    </MudPaper>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 fondo-suave flex-grow-1 overflow-auto">

    <MudGrid Spacing="2">
        @foreach (var prod in _filteredProducts)
        {
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudCard Elevation="0" Class="product-card" @onclick="@(() => AddToCart(prod))">
                    <div class="product-image-container">

                        @if (!string.IsNullOrEmpty(prod.ImagenUrl))
                        {
                            <img src="productos/@prod.ImagenUrl"
                                 alt="@prod.Nombre" />
                        }
                        else
                        {
                            @* Si no hay imagen, mantenemos tu lógica de iconos actual *@
                            <MudIcon Icon="@(prod.BOM ? Icons.Material.Filled.Restaurant : Icons.Material.Filled.ShoppingBasket)"
                                     Size="Size.Large"
                                     Style="opacity: 0.2" />
                        }

                    </div>
                    <MudCardContent Class="pa-2 text-center">
                        <MudText Typo="Typo.caption" Class="truncate-text d-block">#<b>@prod.Id</b></MudText>
                        <MudText Typo="Typo.caption" Class="truncate-text d-block"><b>@prod.Nombre</b></MudText>
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">RD$ @prod.Precio.ToString("N0")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

</MudContainer>

@code {
    private string busqueda = string.Empty;

    private async Task NuevoVehiculo()
    {
        
    }
}
